{
  "uid": "fixa-observability",
  "title": "FIXA | Observabilidade multiagente",
  "tags": ["fixa", "langgraph", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-7d", "to": "now"},
  "panels": [
    {"id": 1, "type": "stat", "title": "Custo semanal | 100 usuários (USD)", "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "fixa_weekly_estimated_cost_usd{weekly_active_users=\"100\"}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "currencyUSD", "decimals": 4}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "area"}},
    {"id": 2, "type": "stat", "title": "Custo semanal | 1.000 usuários (USD)", "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "fixa_weekly_estimated_cost_usd{weekly_active_users=\"1000\"}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "currencyUSD", "decimals": 4}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "area"}},
    {"id": 3, "type": "stat", "title": "Tempo total de resposta (p95)", "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "histogram_quantile(0.95, sum(rate(fixa_chat_response_seconds_bucket[5m])) by (le))", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value"}},
    {"id": 4, "type": "stat", "title": "Índice de erros de chat (5 min)", "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "100 * sum(rate(fixa_chat_requests_total{outcome=\"error\"}[5m])) / clamp_min(sum(rate(fixa_chat_requests_total[5m])), 0.000001)", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percent", "decimals": 2}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value"}},
    {"id": 5, "type": "timeseries", "title": "Latência por agente/nó (p95)", "gridPos": {"h": 9, "w": 12, "x": 0, "y": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "histogram_quantile(0.95, sum(rate(fixa_graph_node_seconds_bucket[5m])) by (le, node))", "legendFormat": "{{node}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 6, "type": "timeseries", "title": "Custo LLM acumulado (USD)", "gridPos": {"h": 9, "w": 12, "x": 12, "y": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum(fixa_llm_estimated_cost_usd_total)", "legendFormat": "USD", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "currencyUSD", "decimals": 4}, "overrides": []}},
    {"id": 7, "type": "stat", "title": "Resoluções (ocorrências concluídas, 7d)", "gridPos": {"h": 5, "w": 6, "x": 0, "y": 14}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum(increase(fixa_resolutions_total[7d]))", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value"}},
    {"id": 8, "type": "stat", "title": "Custo médio da requisição que registrou resolução (USD, 7d)", "gridPos": {"h": 5, "w": 9, "x": 6, "y": 14}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum(increase(fixa_resolution_request_cost_usd_sum[7d])) / clamp_min(sum(increase(fixa_resolution_request_cost_usd_count[7d])), 1)", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "currencyUSD", "decimals": 5}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value"}},
    {"id": 9, "type": "stat", "title": "ROI estimado (7d, BRL)", "description": "Sem dados enquanto OBSERVABILITY_VALUE_PER_RESOLUTION_BRL ou OBSERVABILITY_BRL_PER_USD estiver vazio.", "gridPos": {"h": 5, "w": 9, "x": 15, "y": 14}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "((max(fixa_roi_value_per_resolution_brl) * sum(increase(fixa_resolutions_total[7d]))) - (sum(increase(fixa_llm_estimated_cost_usd_total[7d])) * max(fixa_brl_per_usd))) / clamp_min(sum(increase(fixa_llm_estimated_cost_usd_total[7d])) * max(fixa_brl_per_usd), 0.000001) * 100 * (max(fixa_roi_value_configured) == 1)", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percent", "decimals": 2}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value"}},
    {"id": 10, "type": "timeseries", "title": "Execuções de nós e operações de negócio por resultado", "gridPos": {"h": 8, "w": 24, "x": 0, "y": 19}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum by (node, outcome) (rate(fixa_graph_node_runs_total[5m]))", "legendFormat": "{{node}} / {{outcome}}", "refId": "A"}, {"expr": "sum by (operation, outcome) (rate(fixa_business_operations_total[5m]))", "legendFormat": "{{operation}} / {{outcome}}", "refId": "B"}], "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}}
  ],
  "annotations": {"list": []},
  "templating": {"list": []},
  "links": []
}
